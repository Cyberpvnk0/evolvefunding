# ---------- Site ----------
# Canonical URL used for Open Graph tags, the sitemap, and robots.txt.
# A bare domain works too; a trailing slash is stripped. If this is blank or
# invalid the site falls back to https://evolvefundingllc.com rather than failing.
NEXT_PUBLIC_SITE_URL=https://evolvefundingllc.com

# ---------- CTA destination (optional) ----------
# Where every CTA on the page sends the visitor. Provider-neutral: an order
# form, a hosted checkout, another landing page, anything with a URL.
# UTM params from the landing URL plus ref=<section> are appended automatically.
# Leave this unset and the buttons still render, but stay inert.
NEXT_PUBLIC_CHECKOUT_URL=

# ---------- Analytics (optional, leave blank to disable) ----------
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# ---------- Lead capture (optional) ----------
# GoHighLevel inbound webhook. The exit-intent phone form POSTs here
# (server-side, never exposed to the browser).
GHL_WEBHOOK_URL=
