# ---------- Required ----------
# Stripe Payment Link. Every CTA on the site sends the visitor here.
# UTM params from the landing URL are appended automatically.
NEXT_PUBLIC_CHECKOUT_URL=https://buy.stripe.com/REPLACE_ME

# ---------- Analytics (optional, leave blank to disable) ----------
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# ---------- Lead capture (optional) ----------
# GoHighLevel inbound webhook. The exit-intent phone form POSTs here (server-side, never exposed to the browser).
GHL_WEBHOOK_URL=

# ---------- Site ----------
# Canonical URL used for Open Graph tags and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://evolvefunding.com
